
FROM node:22-bookworm-slim AS builder

WORKDIR /workspace

ENV CI=true
ENV NEXT_TELEMETRY_DISABLED=1

# Cài pnpm cố định, có retry khi npm registry lỗi tạm thời.
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm install -g pnpm@10.15.1 --no-audit --no-fund

COPY . .

RUN pnpm install --frozen-lockfile

ARG NEXT_PUBLIC_API_URL

ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL}

RUN test -n "$NEXT_PUBLIC_API_URL"

RUN pnpm --filter @sat-hach/api build

RUN pnpm --filter @sat-hach/web build


FROM node:22-bookworm-slim AS runtime

WORKDIR /workspace

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV STUDENT_PHOTO_STORAGE_PATH=/workspace/storage/students

# OpenJPEG chuyển ảnh JP2 sang PNG.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       libopenjp2-tools \
       ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Web hiện tại được khởi động bằng pnpm trong Docker Compose.
RUN npm config set fetch-retries 5 \
    && npm config set fetch-retry-mintimeout 20000 \
    && npm config set fetch-retry-maxtimeout 120000 \
    && npm install -g pnpm@10.15.1 --no-audit --no-fund

COPY --from=builder /workspace /workspace

RUN mkdir -p /workspace/storage/students

EXPOSE 8000
EXPOSE 8001

CMD ["node", "apps/api/dist/main.js"]
